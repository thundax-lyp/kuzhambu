NGINX_HTTP_PORT=8080

MYSQL_ROOT_PASSWORD=kuzhambu
MYSQL_DATABASE=kuzhambu
MYSQL_USERNAME=kuzhambu
MYSQL_PASSWORD=kuzhambu

REDIS_PASSWORD=kuzhambu

SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms512m -Xmx512m
ES_JAVA_OPTS=-Xms512m -Xmx512m

ADMIN_WEB_BASE=/kuzhambu-admin/
ADMIN_API_BASE_URL=/kuzhambu-admin-api/api
ADMIN_CONTEXT_PATH=/kuzhambu-admin-api
ADMIN_STORAGE_CONTENT_PATH=/kuzhambu-admin-api/api/storage/object/
PORTAL_WEB_BASE=/kuzhambu/
PORTAL_API_BASE_URL=/kuzhambu-api/api
PORTAL_CONTEXT_PATH=/kuzhambu-api
PORTAL_STORAGE_CONTENT_PATH=/kuzhambu-api/api/storage/object/

KUZHAMBU_INTERNAL_SECRET=change-me
KUZHAMBU_OPENAPI_ENABLED=true
KUZHAMBU_PORTAL_WEB_BASE_URL=http://localhost:8080/kuzhambu
KUZHAMBU_MULTIPART_MAX_FILE_SIZE=20MB
KUZHAMBU_MULTIPART_MAX_REQUEST_SIZE=20MB
KUZHAMBU_REDIS_TIMEOUT=5s
KUZHAMBU_CACHE_STAT_INTERVAL_MINUTES=15
KUZHAMBU_LOG_LEVEL=INFO
KUZHAMBU_APP_LOG_LEVEL=INFO
KUZHAMBU_LOG_MAX_HISTORY=30
KUZHAMBU_LOG_MAX_FILE_SIZE=100MB
KUZHAMBU_LOG_TOTAL_SIZE_CAP=5GB

KUZHAMBU_OSS_TYPE=local
KUZHAMBU_STORAGE_BUCKET_NAME=local

KUZHAMBU_AI_WORKER_SERVICE_NAME=kuzhambu-ai
KUZHAMBU_AI_WORKER_TIMEOUT_MS=60000
KUZHAMBU_WORKER_ALLOWED_SERVICES=kuzhambu-ai
