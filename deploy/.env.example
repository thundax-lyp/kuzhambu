NGINX_HTTP_PORT=8080

KUZHAMBU_IMAGE_REGISTRY=kuzhambu
KUZHAMBU_IMAGE_TAG=dev
KUZHAMBU_ADMIN_WEB_IMAGE=kuzhambu/admin-web:dev
KUZHAMBU_PORTAL_WEB_IMAGE=kuzhambu/portal-web:dev
KUZHAMBU_ADMIN_STARTER_IMAGE=kuzhambu/admin-starter:dev
KUZHAMBU_PORTAL_STARTER_IMAGE=kuzhambu/portal-starter:dev
KUZHAMBU_WORKERS_IMAGE=kuzhambu/workers:dev
KUZHAMBU_NGINX_IMAGE=kuzhambu/nginx:1.27-alpine
KUZHAMBU_MYSQL_IMAGE=kuzhambu/mysql:8.4
KUZHAMBU_REDIS_IMAGE=kuzhambu/redis:7.2
KUZHAMBU_ELASTICSEARCH_IMAGE=kuzhambu/elasticsearch:8.15.3
KUZHAMBU_ROCKETMQ_IMAGE=kuzhambu/rocketmq:5.3.0

MYSQL_ROOT_PASSWORD=kuzhambu
MYSQL_DATABASE=kuzhambu
MYSQL_USERNAME=kuzhambu
MYSQL_PASSWORD=kuzhambu

REDIS_PASSWORD=kuzhambu

SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms512m -Xmx512m
ES_JAVA_OPTS=-Xms512m -Xmx512m

ADMIN_WEB_BASE=/kuzhambu-admin/
ADMIN_API_BASE_URL=/kuzhambu-admin-api/api
KUZHAMBU_ADMIN_SERVER_PORT=20010
ADMIN_CONTEXT_PATH=/kuzhambu-admin-api
ADMIN_STORAGE_CONTENT_PATH=/kuzhambu-admin-api/api/storage/object/
PORTAL_WEB_BASE=/kuzhambu/
PORTAL_API_BASE_URL=/kuzhambu-api/api
KUZHAMBU_PORTAL_SERVER_PORT=20020
PORTAL_CONTEXT_PATH=/kuzhambu-api
PORTAL_STORAGE_CONTENT_PATH=/kuzhambu-api/api/storage/object/

KUZHAMBU_INTERNAL_SECRET=change-me
KUZHAMBU_OPENAPI_ENABLED=true
KUZHAMBU_KNOWLEDGE_ENABLED=false
KUZHAMBU_KNOWLEDGE_PROVIDER=fastgpt
KUZHAMBU_KNOWLEDGE_FASTGPT_BASE_URL=http://fastgpt-app:3000
KUZHAMBU_KNOWLEDGE_FASTGPT_API_KEY=
KUZHAMBU_KNOWLEDGE_FASTGPT_CHAT_API_KEY=
KUZHAMBU_KNOWLEDGE_FASTGPT_APPID=
KUZHAMBU_KNOWLEDGE_FASTGPT_KNOWLEDGE_BASE_ID=
KUZHAMBU_KNOWLEDGE_FASTGPT_SYNC_MODE=auto
KUZHAMBU_KNOWLEDGE_FASTGPT_TIMEOUT=10s
KUZHAMBU_PORTAL_WEB_BASE_URL=http://localhost:8080/kuzhambu
KUZHAMBU_MULTIPART_MAX_FILE_SIZE=20MB
KUZHAMBU_MULTIPART_MAX_REQUEST_SIZE=20MB
KUZHAMBU_REDIS_TIMEOUT=5s
KUZHAMBU_CACHE_STAT_INTERVAL_MINUTES=15
KUZHAMBU_LOG_LEVEL=INFO
KUZHAMBU_APP_LOG_LEVEL=INFO
KUZHAMBU_LOG_MAX_HISTORY=30
KUZHAMBU_LOG_MAX_FILE_SIZE=100MB
KUZHAMBU_LOG_TOTAL_SIZE_CAP=5GB

KUZHAMBU_OSS_TYPE=local
KUZHAMBU_BACKUP_ROOT_PATH=/backup/kuzhambu
KUZHAMBU_OPERATIONS_BACKUP_SCHEDULE_ENABLED=true
KUZHAMBU_OPERATIONS_BACKUP_STARTUP_ENABLED=true
KUZHAMBU_OPERATIONS_BACKUP_DAILY_CRON=0 0 2 * * ?
KUZHAMBU_OPERATIONS_CLEANUP_SCHEDULE_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_STARTUP_ENABLED=false
KUZHAMBU_OPERATIONS_CLEANUP_DAILY_CRON=0 30 3 * * ?
KUZHAMBU_OPERATIONS_CLEANUP_DEFAULT_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_BACKUP_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_BACKUP_RETENTION_DAYS=30
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_BACKUP_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_EXPORT_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_EXPORT_RETENTION_DAYS=7
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_EXPORT_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_SHARE_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_SHARE_RETENTION_DAYS=90
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_SHARE_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_DRAFT_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_DRAFT_RETENTION_DAYS=30
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_DRAFT_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_REPORT_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_REPORT_RETENTION_DAYS=90
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_REPORT_LIMIT=200
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_HEALTH_CHECK_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_HEALTH_CHECK_RETENTION_DAYS=30
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_HEALTH_CHECK_LIMIT=500
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_LONG_TASK_ENABLED=true
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_LONG_TASK_RETENTION_DAYS=90
KUZHAMBU_OPERATIONS_CLEANUP_EXPIRED_LONG_TASK_LIMIT=200
KUZHAMBU_OPERATIONS_HEALTH_PROBES_ENABLED=false
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TIMEOUT_MS=3000
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TARGETS_0_ENABLED=true
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TARGETS_0_COMPONENT=admin-starter
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TARGETS_0_URL=http://admin-starter:20010/kuzhambu-admin-api/actuator/health
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TARGETS_0_EXPECTED_STATUS=200
KUZHAMBU_OPERATIONS_HEALTH_PROBES_TARGETS_0_DEGRADED_LATENCY_MS=1000
KUZHAMBU_STORAGE_BUCKET_NAME=local
KUZHAMBU_OSS_S3_ENDPOINT=
KUZHAMBU_OSS_S3_REGION=us-east-1
KUZHAMBU_OSS_S3_BUCKET=
KUZHAMBU_OSS_S3_ACCESS_KEY=
KUZHAMBU_OSS_S3_SECRET_KEY=
KUZHAMBU_OSS_S3_PATH_STYLE_ACCESS=true
KUZHAMBU_OSS_S3_LOCATION_PREFIX=
KUZHAMBU_ELASTICSEARCH_URIS=https://127.0.0.1:9200
KUZHAMBU_ELASTICSEARCH_USERNAME=elastic
KUZHAMBU_ELASTICSEARCH_PASSWORD=elastic
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TOPIC=kuzhambu-discovery-search-index-sync
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TAG_UPSERT=UPSERT
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TAG_DELETE=DELETE
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_DELETED_RETENTION_DAYS=7
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_DELETED_CLEANUP_CRON=0 0 3 * * ?

KUZHAMBU_AI_WORKER_SERVICE_NAME=kuzhambu-ai
KUZHAMBU_AI_WORKER_TIMEOUT_MS=60000
KUZHAMBU_WORKER_ALLOWED_SERVICES=kuzhambu-ai
KUZHAMBU_WORKER_LOG_LEVEL=INFO
