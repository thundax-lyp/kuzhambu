FASTGPT_HTTP_PORT=13000

FASTGPT_APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/fastgpt:v4.15.1
FASTGPT_PLUGIN_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/fastgpt-plugin:v1.0.1
FASTGPT_CODE_SANDBOX_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/fastgpt-code-sandbox:v4.15.0
FASTGPT_MCP_SERVER_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/fastgpt-mcp_server:v4.14.23
FASTGPT_AIPROXY_IMAGE=registry.cn-hangzhou.aliyuncs.com/labring/aiproxy:v0.6.5
FASTGPT_AIPROXY_PG_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/pgvector:0.8.0-pg15
FASTGPT_VECTOR_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/pgvector:0.8.0-pg15
FASTGPT_MONGO_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/mongo:5.0.32
FASTGPT_REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/redis:7.2-alpine
FASTGPT_MINIO_IMAGE=registry.cn-hangzhou.aliyuncs.com/fastgpt/minio:RELEASE.2025-09-07T16-13-09Z

FASTGPT_DEFAULT_ROOT_PSW=1234
FASTGPT_ROOT_KEY=fastgpt-root-key-change-me
FASTGPT_FILE_TOKEN_KEY=fastgpt-file-token-key
FASTGPT_AES256_SECRET_KEY=fastgpt-aes256-secret
FASTGPT_INVOKE_TOKEN_SECRET=fastgpt-invoke-token-secret-32chars
FASTGPT_PLUGIN_AUTH_TOKEN=fastgpt-plugin-token-please-change-32
FASTGPT_CODE_SANDBOX_TOKEN=fastgpt-code-sandbox-token
FASTGPT_AIPROXY_TOKEN=fastgpt-aiproxy-token
FASTGPT_AGENT_SANDBOX_PROXY_SECRET=default-fastgpt-agent-sandbox-proxy-secret

FASTGPT_MONGO_USERNAME=fastgpt
FASTGPT_MONGO_PASSWORD=fastgpt
FASTGPT_REDIS_PASSWORD=fastgpt
FASTGPT_VECTOR_USERNAME=fastgpt
FASTGPT_VECTOR_PASSWORD=fastgpt
FASTGPT_VECTOR_DATABASE=postgres
FASTGPT_AIPROXY_PG_USERNAME=postgres
FASTGPT_AIPROXY_PG_PASSWORD=aiproxy
FASTGPT_AIPROXY_PG_DATABASE=aiproxy
FASTGPT_MINIO_ACCESS_KEY=fastgptminio
FASTGPT_MINIO_SECRET_KEY=fastgptminio
FASTGPT_STORAGE_PUBLIC_BUCKET=fastgpt-public
FASTGPT_STORAGE_PRIVATE_BUCKET=fastgpt-private

# MinIO is internal-only by default. If browser-facing file URLs are required later, expose object storage deliberately through a reverse proxy and set this to that public URL.
FASTGPT_STORAGE_EXTERNAL_ENDPOINT=http://fastgpt-minio:9000

FASTGPT_SYSTEM_NAME=FastGPT
FASTGPT_PUBLIC_BASE_URL=
FASTGPT_FE_DOMAIN=
FASTGPT_FILE_DOMAIN=
FASTGPT_MARKETPLACE_URL=https://v2.marketplace.fastgpt.cn
FASTGPT_OPENAPI_KEY_MAX_COUNT=100

# Configure model provider after first login, or set these when using an OpenAI-compatible upstream.
FASTGPT_OPENAI_BASE_URL=
FASTGPT_CHAT_API_KEY=

# Optional bootstrap for a production-like Kuzhambu integration.
# When enabled, bootstrap initializes FastGPT LLM, embedding, OpenAPI key, dataset and app, then emits
# deploy/fastgpt/generated/kuzhambu-fastgpt.env for the Kuzhambu compose env.
FASTGPT_BOOTSTRAP_ENABLED=false
FASTGPT_BOOTSTRAP_WAIT_MS=120000
FASTGPT_BOOTSTRAP_LLM_MODEL=
FASTGPT_BOOTSTRAP_LLM_NAME=
FASTGPT_BOOTSTRAP_LLM_BASE_URL=
FASTGPT_BOOTSTRAP_LLM_API_KEY=
FASTGPT_BOOTSTRAP_LLM_MAX_CONTEXT=16000
FASTGPT_BOOTSTRAP_LLM_MAX_RESPONSE=4096
FASTGPT_BOOTSTRAP_LLM_QUOTE_MAX_TOKEN=12000
FASTGPT_BOOTSTRAP_LLM_MAX_TEMPERATURE=1.2
FASTGPT_BOOTSTRAP_LLM_TEMPERATURE=0.2
FASTGPT_BOOTSTRAP_LLM_MAX_TOKENS=4096
FASTGPT_BOOTSTRAP_EMBEDDING_MODEL=
FASTGPT_BOOTSTRAP_EMBEDDING_NAME=
FASTGPT_BOOTSTRAP_EMBEDDING_BASE_URL=
FASTGPT_BOOTSTRAP_EMBEDDING_API_KEY=
FASTGPT_BOOTSTRAP_EMBEDDING_NORMALIZATION=false
FASTGPT_BOOTSTRAP_EMBEDDING_BATCH_SIZE=10
FASTGPT_BOOTSTRAP_EMBEDDING_DEFAULT_TOKEN=1024
FASTGPT_BOOTSTRAP_EMBEDDING_MAX_TOKEN=8192
FASTGPT_KUZHAMBU_OPENAPI_KEY=
FASTGPT_KUZHAMBU_DATASET_ID=
FASTGPT_KUZHAMBU_DATASET_NAME=kuzhambu
FASTGPT_KUZHAMBU_APP_ID=
FASTGPT_KUZHAMBU_APP_NAME=kuzhambu-qa
FASTGPT_KUZHAMBU_BASE_URL=http://fastgpt-app:3000
FASTGPT_KUZHAMBU_TIMEOUT=30s
