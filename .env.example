# Kuzhambu local runtime example.
# Copy to .env for local shell usage or map these values into your deployment system.

# Server
# Use one app at a time with SERVER_PORT and SERVER_SERVLET_CONTEXT_PATH.
# Admin defaults: 20010 /kuzhambu-admin-api
# Portal defaults: 20011 /kuzhambu-api
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=20010
SERVER_SERVLET_CONTEXT_PATH=/kuzhambu-admin-api
JAVA_OPTS="-Xms512m -Xmx512m"

# Database
KUZHAMBU_DB_DRIVER=com.mysql.cj.jdbc.Driver
KUZHAMBU_DB_URL=jdbc:mysql://127.0.0.1:3306/kuzhambu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
KUZHAMBU_DB_USERNAME=kuzhambu
KUZHAMBU_DB_PASSWORD=kuzhambu

# Redis
KUZHAMBU_REDIS_URI=redis://127.0.0.1:6379/0
KUZHAMBU_REDIS_PASSWORD=kuzhambu
KUZHAMBU_REDIS_TIMEOUT=5s
KUZHAMBU_JETCACHE_REDIS_URI=redis://:kuzhambu@127.0.0.1:6379/0
KUZHAMBU_CACHE_STAT_INTERVAL_MINUTES=15

# RocketMQ
KUZHAMBU_ROCKETMQ_NAME_SERVER=127.0.0.1:9876
KUZHAMBU_ROCKETMQ_PRODUCER_GROUP=kuzhambu-admin-starter-producer
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TOPIC=kuzhambu.discovery.search.index-sync
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TAG_UPSERT=UPSERT
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_TAG_DELETE=DELETE
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_DELETED_RETENTION_DAYS=7
KUZHAMBU_DISCOVERY_SEARCH_INDEX_SYNC_DELETED_CLEANUP_CRON=0 0 3 * * ?

# Operations backup
KUZHAMBU_BACKUP_ROOT_PATH=/backup/kuzhambu
KUZHAMBU_OPERATIONS_BACKUP_SCHEDULE_ENABLED=true
KUZHAMBU_OPERATIONS_BACKUP_STARTUP_ENABLED=true
KUZHAMBU_OPERATIONS_BACKUP_DAILY_CRON=0 0 2 * * ?

# Auth
KUZHAMBU_AUTH_CAPTCHA_WHITELIST_ENABLED=true
KUZHAMBU_AUTH_CAPTCHA_WHITELIST_VALUES=6666

# OpenAPI
KUZHAMBU_OPENAPI_ENABLED=true

# External knowledge base: FastGPT
KUZHAMBU_FASTGPT_BASE_URL=http://localhost:13000
KUZHAMBU_FASTGPT_LOGIN_USERNAME=root
KUZHAMBU_FASTGPT_LOGIN_PASSWORD=1234
KUZHAMBU_FASTGPT_API_KEY_NAME=kuzhambu-dev
KUZHAMBU_FASTGPT_API_KEY=

# Common knowledge abstraction
KUZHAMBU_KNOWLEDGE_ENABLED=false
KUZHAMBU_KNOWLEDGE_PROVIDER=fastgpt
KUZHAMBU_KNOWLEDGE_FASTGPT_BASE_URL=http://localhost:13000
KUZHAMBU_KNOWLEDGE_FASTGPT_API_KEY=
KUZHAMBU_KNOWLEDGE_FASTGPT_APP_ID=
KUZHAMBU_KNOWLEDGE_FASTGPT_TIMEOUT=10s

# Classics sharing
KUZHAMBU_PORTAL_WEB_BASE_URL=http://localhost:5174

# Multipart upload, admin starter only.
KUZHAMBU_MULTIPART_MAX_FILE_SIZE=20MB
KUZHAMBU_MULTIPART_MAX_REQUEST_SIZE=20MB

# Logging
KUZHAMBU_LOG_PATH=logs
KUZHAMBU_LOG_LEVEL=INFO
KUZHAMBU_APP_LOG_LEVEL=INFO
KUZHAMBU_LOG_MAX_HISTORY=30
KUZHAMBU_LOG_MAX_FILE_SIZE=100MB
KUZHAMBU_LOG_TOTAL_SIZE_CAP=5GB

# OSS
# local or s3
KUZHAMBU_OSS_TYPE=local
KUZHAMBU_OSS_LOCAL_ROOT_PATH=storage/object
KUZHAMBU_OSS_S3_ENDPOINT=http://127.0.0.1:9000
KUZHAMBU_OSS_S3_REGION=us-east-1
KUZHAMBU_OSS_S3_BUCKET=kuzhambu-storage
KUZHAMBU_OSS_S3_ACCESS_KEY=kuzhambuminio
KUZHAMBU_OSS_S3_SECRET_KEY=
KUZHAMBU_OSS_S3_PATH_STYLE_ACCESS=true
KUZHAMBU_STORAGE_BUCKET_NAME=local
KUZHAMBU_STORAGE_CONTENT_PATH=/kuzhambu-admin-api/api/storage/object/

# Elasticsearch
KUZHAMBU_ELASTICSEARCH_URIS=https://127.0.0.1:9200
KUZHAMBU_ELASTICSEARCH_USERNAME=elastic
KUZHAMBU_ELASTICSEARCH_PASSWORD=elastic

# AI workers internal endpoint
KUZHAMBU_AI_WORKER_BASE_URL=http://127.0.0.1:8000
KUZHAMBU_AI_WORKER_INTERNAL_SECRET=change-me
KUZHAMBU_AI_WORKER_SERVICE_NAME=kuzhambu-ai
KUZHAMBU_AI_WORKER_TIMEOUT_MS=60000
