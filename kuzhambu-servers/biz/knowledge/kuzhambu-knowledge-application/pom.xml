<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.thundax</groupId>
    <artifactId>kuzhambu-knowledge</artifactId>
    <version>0.0.1-dev</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>kuzhambu-knowledge-application</artifactId>
  <packaging>jar</packaging>

  <name>kuzhambu-knowledge-application</name>

  <dependencies>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-knowledge-facade</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-knowledge-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-ai-facade</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-classics-facade</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-common-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-common-audit</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-common-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.thundax</groupId>
      <artifactId>kuzhambu-common-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-knowledge-graph-schema</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/schema</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../../../docs/20-interfaces</directory>
                  <includes>
                    <include>KNOWLEDGE-GRAPH-SCHEMA.json</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
