{
  "priority": 13,
  "capability": "KNOWLEDGE_GRAPH_EXTRACT",
  "suite": "knowledge-default-v1",
  "name": "知识图谱抽取提示词",
  "description": "知识图谱抽取默认提示词。",
  "enabled": true,
  "versionNo": 1,
  "current": true,
  "variables": [
    {
      "name": "sourceTitle",
      "required": false,
      "description": "来源标题"
    },
    {
      "name": "sourceText",
      "required": true,
      "description": "待抽取图谱的文本"
    },
    {
      "name": "entryRefs",
      "required": false,
      "description": "相关条目引用"
    }
  ],
  "outputSchema": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "1.0.0"
      },
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": {
              "type": "string"
            },
            "nodeType": {
              "type": "string",
              "enum": [
                "PERSON", "GROUP", "DYNASTY", "ORGANIZATION", "OFFICE", "PLACE", "BUILDING",
                "WORK", "EVENT", "RITUAL", "CONCEPT", "OBJECT", "MATERIAL", "ANIMAL", "PLANT",
                "CELESTIAL_BODY", "NATURAL_PHENOMENON", "DEITY"
              ]
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "id", "name", "nodeType"
          ]
        }
      },
      "edges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "sourceId": {
              "type": "string"
            },
            "targetId": {
              "type": "string"
            },
            "relationType": {
              "type": "string",
              "enum": [
                "PARENT_OF", "ANCESTOR_OF", "SPOUSE_OF", "MEMBER_OF", "HOLDS_OFFICE", "RULES",
                "LOCATED_IN", "PART_OF", "AUTHORED", "COMPILED", "DEPICTS", "DESCRIBES", "OCCURS_AT",
                "PARTICIPATED_IN", "OBSERVED_IN"
              ]
            }
          },
          "required": [
            "id",
            "sourceId",
            "targetId",
            "relationType"
          ]
        }
      }
    },
    "required": [
      "schemaVersion",
      "nodes",
      "edges"
    ]
  },
  "changeSummary": "Initial knowledge default graph extraction prompt."
}
