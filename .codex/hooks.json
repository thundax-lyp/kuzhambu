{
  "description": "Format Java and TypeScript files after Codex edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/format_after_edit.mjs",
            "timeout": 60,
            "statusMessage": "Formatting modified source files"
          }
        ]
      }
    ]
  }
}